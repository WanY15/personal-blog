# 复制为 .env（或直接在部署平台的环境变量里配置）
# 只使用 PUBLIC_ 前缀的变量：它们会被打进静态产物，不要放任何密钥。

# ── 构建期变量（非 PUBLIC_，只在构建时使用）──────────────────
# 部署平台（如 Cloudflare Pages）的环境变量里设置；本地 shell 也可以用
# SITE_URL=https://your-site.pages.dev/

# ── 评论（Giscus）────────────────────────────────────────────
# 当前站点已启用（WanY15/blog-comments · General 分类）
# 以下变量用于覆盖仓库配置，不填则使用 src/config.ts 中的默认值
PUBLIC_GISCUS_REPO=owner/repo
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=
# 强制开启/关闭（不设时以 config.ts 的 enable 为准），true / false
# PUBLIC_GISCUS_ENABLE=true

# ── 访问统计（三选一）────────────────────────────────────────
# umami | cloudflare | google | none
PUBLIC_ANALYTICS_PROVIDER=none

# Umami（Cloud 或自建）
PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
PUBLIC_UMAMI_WEBSITE_ID=

# Cloudflare Web Analytics（beacon token）
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Google Analytics 4
PUBLIC_GA_MEASUREMENT_ID=

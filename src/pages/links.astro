---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const friends = [
	{
		name: "Fuwari",
		desc: "本站使用的 Astro 博客主题，简洁、可定制，MIT 协议。",
		url: "https://github.com/saicaca/fuwari",
		letter: "F",
		from: "#38bdf8",
		to: "#6366f1",
	},
	{
		name: "Astro",
		desc: "以内容为中心的现代静态站点框架，本站的构建工具。",
		url: "https://astro.build",
		letter: "A",
		from: "#f97316",
		to: "#ec4899",
	},
	{
		name: "Pagefind",
		desc: "轻量的静态站点全文搜索，本站搜索框的幕后功臣。",
		url: "https://pagefind.app",
		letter: "P",
		from: "#22c55e",
		to: "#0ea5e9",
	},
	{
		name: "Tailwind CSS",
		desc: "原子化 CSS 框架，用来快速搭出耐看的界面。",
		url: "https://tailwindcss.com",
		letter: "T",
		from: "#06b6d4",
		to: "#3b82f6",
	},
];
---

<MainGridLayout title="友链" description="WanY 常看的站点与常用工具">
    <div class="card-base px-6 md:px-9 py-8 mb-4">
        <h1 class="text-2xl font-bold mb-2">友链</h1>
        <p class="text-75 mb-6 leading-relaxed">
            这里放一些我常看的站点和正在用的工具。想交换友链的话，欢迎在 GitHub 上给我提 issue，或者发邮件聊聊。
        </p>
        <div class="grid gap-4 sm:grid-cols-2">
            {friends.map((friend) => (
                <a
                    href={friend.url}
                    target="_blank"
                    rel="noopener"
                    class="group flex items-start gap-4 rounded-xl bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] p-4 transition active:scale-[0.98]"
                >
                    <div
                        class="w-12 h-12 rounded-xl flex items-center justify-center text-white font-bold text-xl shrink-0 transition"
                        style={`background-image: linear-gradient(135deg, ${friend.from}, ${friend.to})`}
                    >
                        {friend.letter}
                    </div>
                    <div class="min-w-0">
                        <div class="font-bold flex items-center gap-1.5">
                            {friend.name}
                            <Icon
                                name="fa6-solid:arrow-up-right-from-square"
                                class="text-[0.7rem] opacity-0 group-hover:opacity-60 transition"
                            />
                        </div>
                        <div class="text-sm text-50 leading-relaxed mt-0.5">{friend.desc}</div>
                    </div>
                </a>
            ))}
        </div>
    </div>

    <div class="card-base px-6 md:px-9 py-6">
        <h2 class="text-lg font-bold mb-2">申请友链</h2>
        <p class="text-75 leading-relaxed">
            本站友链都是手动挑选的，所以没有申请表单。附上你的站点地址和一句介绍，通过
            <a class="link link-underline text-[var(--primary)]" href="https://github.com/WanY15" target="_blank" rel="noopener">GitHub</a>
            或邮箱告诉我就好。
        </p>
    </div>
</MainGridLayout>

---
import PostList from "@components/PostList.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts, getTagList } from "@utils/content-utils";
import { url } from "@utils/url-utils";
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async () => {
	const tags = await getTagList();
	const posts = await getSortedPosts();

	return tags.map((tag) => ({
		params: { tag: tag.name },
		props: {
			tag: tag.name,
			posts: posts.filter((post) => post.data.tags.includes(tag.name)),
		},
	}));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<MainGridLayout title={`#${tag}`} description={`标签 ${tag} 下的全部文章`}>
    <div class="card-base px-6 md:px-9 py-5 mb-4 onload-animation flex items-center justify-between gap-3">
        <div class="flex items-center gap-2 font-bold text-lg text-90 min-w-0">
            <Icon name="material-symbols:tag-rounded" class="text-[var(--primary)] shrink-0"></Icon>
            <span class="text-[var(--primary)] shrink-0">#</span>
            <span class="truncate">{tag}</span>
            <span class="text-sm font-normal text-50 shrink-0">({posts.length})</span>
        </div>
        <a href={url("/tags/")} class="text-sm text-50 hover:text-[var(--primary)] transition shrink-0">
            {i18n(I18nKey.tags)}
        </a>
    </div>

    <PostList posts={posts} />
</MainGridLayout>

---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getTagList } from "@utils/content-utils";
import { getTagUrl } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

const tags = await getTagList();
const sortedTags = [...tags].sort(
	(a, b) => b.count - a.count || a.name.localeCompare(b.name),
);
const totalCount = tags.reduce((sum, tag) => sum + tag.count, 0);
---

<MainGridLayout title={i18n(I18nKey.tags)} description={`全部标签，共 ${tags.length} 个`}>
    <div class="card-base px-6 md:px-9 py-8 onload-animation">
        <h1 class="flex items-center gap-2 text-2xl font-bold mb-2 text-90">
            <Icon name="material-symbols:tag-rounded" class="text-[var(--primary)]"></Icon>
            {i18n(I18nKey.tags)}
        </h1>
        <p class="text-75 mb-6 text-sm">{tags.length} 个标签 · 共 {totalCount} 次使用</p>

        {tags.length > 0 ? (
            <div class="flex flex-wrap gap-2.5">
                {sortedTags.map((tag) => (
                    <a
                        href={getTagUrl(tag.name)}
                        class="group inline-flex items-center gap-2 rounded-lg bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] px-3 py-2 text-sm font-medium transition active:scale-95"
                    >
                        <span class="text-[var(--primary)]">#</span>
                        <span>{tag.name}</span>
                        <span class="rounded-md bg-[var(--card-bg)] px-1.5 py-0.5 text-xs text-50 transition group-hover:text-[var(--primary)]">
                            {tag.count}
                        </span>
                    </a>
                ))}
            </div>
        ) : (
            <p class="text-50">暂无标签</p>
        )}
    </div>
</MainGridLayout>

---
import type { CollectionEntry } from "astro:content";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
    <div class="card-base px-6 md:px-9 py-6 mb-4 onload-animation">
        <h2 class="flex items-center gap-2 font-bold text-lg mb-4 text-90">
            <Icon name="fa6-solid:link" class="text-[var(--primary)]"></Icon>
            {i18n(I18nKey.relatedPosts)}
        </h2>
        <div class="flex flex-col gap-3">
            {posts.map((post) => (
                <a
                    href={getPostUrlBySlug(post.slug)}
                    class="group flex items-start gap-3 rounded-xl bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] p-4 transition active:scale-[0.99]"
                >
                    <div class="mt-0.5 text-[var(--primary)] shrink-0">
                        <Icon name="fa6-solid:file-lines"></Icon>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="font-bold transition group-hover:text-[var(--primary)]">
                            {post.data.title}
                        </div>
                        <div class="mt-1 text-sm text-50 leading-relaxed line-clamp-2">
                            {post.data.description}
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </div>
)}
